# ══════════════════════════════════════════════════════════════════════════════
# Off_Shore_Insights — connection reference (.env)
# ══════════════════════════════════════════════════════════════════════════════
# This is the COMMITTED template: placeholders and non-secret defaults only.
# The real file is `.env` (gitignored — this repo is public). Generate/refresh it:
#     bash scripts/sync-env.sh
# which copies this template, fills every "Master:" key live from the Pi, and
# keeps project-local values (workflow IDs, test user, …) already in .env.
# If a value here goes stale, the master wins — re-run the script.
# ══════════════════════════════════════════════════════════════════════════════

# ── Site ──────────────────────────────────────────────────────────────────────
# nginx:alpine container serving apps/web/dist, exposed via the shared pi-tunnel.
SITE_URL=https://insights.codeine.cloud
SITE_LOCAL_URL=http://192.168.0.50:8094
SITE_PORT=8094
SITE_CONTAINER=offshore-insights-web
# Compose file: server/web/docker-compose.yml (on the Pi under PI_DEPLOY_DIR)
PI_DEPLOY_DIR=/home/codeine/Off_Shore_Insights

# ── Raspberry Pi ──────────────────────────────────────────────────────────────
# Master: /home/codeine/.env.network (ETH_IP / WIFI_IP) + reference.md §1
# SSH: key-only, passwordless.  ssh codeine@$PI_LAN_IP
PI_SSH_USER=codeine
PI_LAN_IP=
PI_WIFI_IP=
PI_MESHNET_IP=100.82.67.241
PI_SSHFS_DRIVE=Z:
# Z: is for READING only. Never edit a deploy checkout through it (CRLF/770 breaks git pull).

# ── GitHub ────────────────────────────────────────────────────────────────────
# Push needs no token (Git Credential Manager). For API calls (webhooks, repo
# settings) fetch the token for ONE command only — do not store it here:
#   GH_TOKEN=$(printf 'protocol=https\nhost=github.com\n\n' | git credential fill | sed -n 's/^password=//p') <command>
GITHUB_OWNER=CodeineZA
GITHUB_REPO=Off_Shore_Insights
GITHUB_PUSH_HOOK_ID=

# ── Supabase (shared instance on the Pi) ──────────────────────────────────────
# Master: /home/codeine/server/services/supabase/.env — read that folder's
# CLAUDE.md before touching the instance. This project's schema: offshore_insights.
SUPABASE_URL=
SUPABASE_LOCAL_URL=http://192.168.0.50:8000
SUPABASE_SCHEMA=offshore_insights
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
POSTGRES_PASSWORD=
# Direct psql (on the Pi):  docker exec -i supabase-db psql -U postgres -d postgres < file.sql
# Pooler: $PI_LAN_IP:5433 (session) / :6543 (transaction), user postgres.<POOLER_TENANT_ID>
POSTGRES_PORT=5433
POOLER_TENANT_ID=
# Studio (https://supabase.codeine.cloud, HTTP Basic Auth):
SUPABASE_DASHBOARD_USER=
SUPABASE_DASHBOARD_PASS=
# Users created without an email get <username>@AUTH_USERNAME_DOMAIN (never receives mail).
AUTH_USERNAME_DOMAIN=users.insights.codeine.cloud

# ── n8n ───────────────────────────────────────────────────────────────────────
# Master API key: /home/codeine/server/services/n8n/Claude_n8n.md
# API: $N8N_LOCAL_URL/api/v1/…  header X-N8N-API-KEY
N8N_URL=
N8N_LOCAL_URL=http://192.168.0.50:5678
N8N_API_KEY=
N8N_DEPLOY_WEBHOOK=https://n8n.codeine.cloud/webhook/offshore-insights-github-update
N8N_SSH_CREDENTIAL=SSH Password account
N8N_WF_GITSYNC=
N8N_WF_RECHECK=
N8N_WF_TELEGRAM_CB=
N8N_WF_MONTHLY=
N8N_WF_BUDGET=
N8N_WF_EUROSTAT=

# ── Cloudflare ────────────────────────────────────────────────────────────────
# Master: /home/codeine/Weave_proj/.env (the only token that verifies, 2026-09-29).
# Run API calls ON THE PI. Tunnel ingress PUT replaces the whole list: GET first.
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_TUNNEL_ID=96c687b4-7513-4673-9fa9-48614d77a573
CF_DNS_RECORD_ID_INSIGHTS=

# ── Telegram ──────────────────────────────────────────────────────────────────
# Reuses the existing n8n credential (bot token lives encrypted inside n8n).
TELEGRAM_N8N_CREDENTIAL=Telegram account
TELEGRAM_CHAT_ID=6688393980
TELEGRAM_ALLOWED_USER_IDS=6688393980

# ── Test user (for Claude's automated checks; safe to reuse) ──────────────────
TEST_USER_USERNAME=claude-test
TEST_USER_PASSWORD=
